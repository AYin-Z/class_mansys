# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
*.local

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
# 默认忽略所有 .env 文件，但显式白名单 .env.example / .env.development，
# 方便多人协作时共享无密的默认配置
**/.env
**/.env.*
!.env.example
!.env.development

# Archives
*.zip

# 用户上传文件（含请假证明/相册/资源，含真实个人数据，禁止入库）
backend/uploads/

# Legacy files
_legacy/

# AI tool directories
.agents/
.codebuddy/
.reasonix/
rules/

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build output
dist/
build/
.vitest/
coverage/

# HBuilderX / uni-app
unpackage/
.hbuilderx/
dev-app.log
dev-app.err.log

# HBuilderX CLI 项目识别用的根级硬链接（指向 src/manifest.json 与 src/pages.json）
# 这两个文件是让 HBuilderX 打开项目根时认出 uni-app 项目用的，Git 不需要跟踪
/manifest.json
/pages.json

# Android 签名证书：**绝不能**进 Git
# 如本地自己生成的 keystore 放在项目里，这里拦住
*.keystore
*.jks
*.p12
cert/
certs/

# APK 构建产物（发布产物放仓库外，由 backend/.env 的 APK_DIR 指向）
android/app/build/outputs/
*.apk
backend/apk/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/debug/
android/captures/

# CI 临时文件
scripts/.versionCode
scripts/.versionName

# HBuilderX CLI 打包过程日志（排错辅助，不入仓库）
pack.log
publish.log

# Android 签名密钥目录（本地 CI runner 专用，不入仓库）
android-key/