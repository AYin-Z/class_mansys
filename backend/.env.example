# backend/.env.example — 复制为 backend/.env 后填入真实值（.env 已在 .gitignore 且严禁入库）
# 数据库配置
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=class_manage_sys
DB_PORT=3306

# JWT配置
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=3002
NODE_ENV=production

# 微信小程序配置（如仍使用微信登录）
APPID=
APPSECRET=

# 验证码/OTP 服务：sms | email | webhook，未配置时生产环境明确返回 503
# OTP_PROVIDER=
# OTP_DEBUG_CONSOLE=true

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5mb

# ---- 对话式 Agent（办事助手）----
# auto=有密钥走真实模型，无密钥降级 mock；mock=规则匹配；off=关闭
AGENT_LLM_MODE=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
AGENT_MAX_STEPS=6
AGENT_DAILY_QUOTA=200
AGENT_ACTION_TTL_MS=300000
# SELF_BASE_URL=

# ---- 每日建议汇总邮件 ----
# QQ 邮箱需使用「授权码」（设置 → 账户 → 开启 SMTP 服务 → 生成授权码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
SUGGESTION_DIGEST_TO=
