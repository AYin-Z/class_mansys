# backend/.env.example — 复制为 backend/.env 后填入真实值（.env 已在 .gitignore 且严禁入库）
# 数据库配置
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=class_manage_sys
DB_PORT=3306

# JWT配置
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=3002
NODE_ENV=production

# 微信小程序配置（如仍使用微信登录）
APPID=
APPSECRET=

# 验证码/OTP 服务：sms | email | webhook，未配置时生产环境明确返回 503
# OTP_PROVIDER=
# OTP_DEBUG_CONSOLE=true

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5mb

# ---- /uploads 访问鉴权（隐私材料）----
# strict（默认，推荐）：必须携带令牌，支持 Authorization: Bearer <JWT> 与 ?token=<JWT> 两种方式，
#   否则 401/403；前端 frontend-v3/src/utils/media.ts 会自动给 /uploads 链接补 ?token=。
# compat：兼容尚未携带令牌的旧版 APK，匿名请求一律放行——会让请假证明等隐私材料可被公网匿名读取，
#   仅在旧 APK 铺开前临时开启，铺开后必须切回 strict（middleware/uploadAuth.js）。
UPLOAD_AUTH_MODE=strict

# ---- 对话式 Agent（办事助手）----
# auto=有密钥走真实模型，无密钥降级 mock；mock=规则匹配；off=关闭
# auto：配了 LLM_LOCAL_BASE_URL 就走 hybrid（本地优先+远端兜底），否则有 key 走 live
AGENT_LLM_MODE=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 本地模型（llama-server，见 scripts/serve-local-llm.sh）。留空=不用本地。
LLM_LOCAL_BASE_URL=
LLM_LOCAL_MODEL=
LLM_LOCAL_TIMEOUT_MS=8000
# hybrid 下谁优先：local=本地优先（省钱）；remote=远端优先、本地只兜底（灰度期）
LLM_PREFER=local
# 上游连续失败几次后临时跳过，避免本地假死时每个请求都白等满超时
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_MS=60000
AGENT_MAX_STEPS=6
AGENT_DAILY_QUOTA=200
AGENT_ACTION_TTL_MS=300000
# SELF_BASE_URL=

# ---- 每日建议汇总邮件 ----
# QQ 邮箱需使用「授权码」（设置 → 账户 → 开启 SMTP 服务 → 生成授权码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
SUGGESTION_DIGEST_TO=
