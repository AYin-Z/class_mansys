[Unit]
Description=class_mansys WeChat (iLink Bot) long-poll worker
After=network-online.target class-mansys.service

[Service]
Type=simple
WorkingDirectory=/home/ayin/Current_Works/class_mansys/backend
ExecStart=/usr/bin/node /home/ayin/Current_Works/class_mansys/backend/scripts/ilink-worker.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
